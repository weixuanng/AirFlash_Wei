<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Name="Airplay"
           Manufacturer="Airplay"
           Version="$(var.ProductVersion)"
           UpgradeCode="{E9C2A5B0-6A5F-4D4C-9B9F-8F3E1A56A1D3}"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="Windows system audio to AirPlay receivers"/>
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of Airplay is already installed."/>
    <MediaTemplate EmbedCab="yes"/>
    <util:CloseApplication Id="CloseRunningApplication"
                           Target="Airplay.exe"
                           CloseMessage="yes"
                           EndSessionMessage="yes"
                           Timeout="10"
                           Property="AIRPLAY_STILL_RUNNING"
                           RebootPrompt="no"
                           Sequence="1"/>
    <!-- The engine has no window. Airplay stops it on exit; this only ends a straggler
         so its installed file is not in use. -->
    <util:CloseApplication Id="CloseRunningEngine"
                           Target="airflash-engine.exe"
                           TerminateProcess="1"
                           Timeout="5"
                           RebootPrompt="no"
                           Sequence="2"/>
    <CustomAction Id="RequireAirplayExited"
                  Error="Airplay could not exit. Close Airplay, then retry installation or removal."/>
    <InstallExecuteSequence>
      <Custom Action="override Wix4CloseApplications_X64" Before="RequireAirplayExited"/>
      <Custom Action="RequireAirplayExited" Before="InstallValidate" Condition="AIRPLAY_STILL_RUNNING"/>
    </InstallExecuteSequence>
    <SetProperty Id="REINSTALLMODE" Value="amus" Before="CostInitialize" Sequence="both"/>
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute"/>

    <Icon Id="ApplicationIcon" SourceFile="$(var.AppIcon)"/>
    <Property Id="ARPPRODUCTICON" Value="ApplicationIcon"/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.UiLicenseFile)"/>
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)"/>
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)"/>

    <!-- One screen to install, then an optional launch. Shortcuts stay separate
         features, so ADDLOCAL/REMOVE still choose them on the command line. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Airplay now"/>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
    <Property Id="WixShellExecTarget" Value="[#ApplicationExe]"/>
    <CustomAction Id="LaunchAirplay" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes"/>
    <UI>
      <ui:WixUI Id="WixUI_Minimal"/>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAirplay" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed"/>
    </UI>

    <Property Id="AIRPLAY_OS_BUILD">
      <RegistrySearch Id="ReadWindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64"/>
    </Property>
    <Property Id="AIRPLAY_OS_ARCH">
      <RegistrySearch Id="ReadWindowsArchitecture" Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment" Name="PROCESSOR_ARCHITECTURE" Type="raw" Bitness="always64"/>
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND AIRPLAY_OS_ARCH = &quot;AMD64&quot; AND AIRPLAY_OS_BUILD &gt;= 17763)" Message="Windows 10 version 1809 (build 17763) or later on an x64 system is required."/>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Airplay"/>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AirplayProgramsFolder" Name="Airplay"/>
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ApplicationComponent" Guid="{B5DB5EE1-5BF1-48ED-AF69-1324D9DE4A09}">
        <RemoveFile Id="ReplaceApplicationExe" Name="Airplay.exe" On="install"/>
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall"/>
        <File Id="ApplicationExe"
              Source="$(var.AppExe)"
              KeyPath="yes"
              Checksum="yes"/>
      </Component>
      <!-- The same engine Airplay.exe embeds, at a fixed path the firewall rule can name.
           Without it the engine runs from a per-user folder that changes with every
           update, and Windows Firewall asks again each time. -->
      <Component Id="EngineComponent" Guid="{FB74A546-CD87-4AA7-9E52-0EB5D1E144EB}">
        <File Id="EngineExe"
              Name="airflash-engine.exe"
              Source="$(var.EngineExe)"
              KeyPath="yes"
              Checksum="yes">
          <fw:FirewallException Id="EngineFirewall"
                                Name="Airplay audio engine"
                                Description="Lets HomePods on your local network reach Airplay for clock sync and audio."
                                Scope="localSubnet"
                                IgnoreFailure="yes"/>
        </File>
      </Component>
      <!-- Owned by the MSI so uninstall removes it; the app writes the same value at launch. -->
      <Component Id="AutostartComponent" Guid="{816714DD-9A9B-4DCD-B0F6-2F383136D896}">
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="Airplay"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]Airplay.exe&quot; --startup"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="{A4F96A74-C925-4BB9-8C80-7A4BA9AE2024}">
        <Shortcut Id="DesktopShortcut"
                  Name="Airplay"
                  Description="Send Windows system audio to an AirPlay receiver"
                  Target="[INSTALLFOLDER]Airplay.exe"
                  Icon="ApplicationIcon" IconIndex="0"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RegistryValue Root="HKCU"
                       Key="Software\Airplay"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </StandardDirectory>

    <DirectoryRef Id="AirplayProgramsFolder">
      <Component Id="StartMenuShortcutComponent" Guid="{6BDBB7C5-9207-44C5-9A8A-C8B5544D6F8A}">
        <Shortcut Id="StartMenuShortcut"
                  Name="Airplay"
                  Description="Send Windows system audio to an AirPlay receiver"
                  Target="[INSTALLFOLDER]Airplay.exe"
                  Icon="ApplicationIcon" IconIndex="0"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\Airplay"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature"
             Title="Airplay"
             Description="Airplay application"
             Level="1"
             AllowAbsent="no"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="ApplicationComponent"/>
      <ComponentRef Id="EngineComponent"/>
      <ComponentRef Id="AutostartComponent"/>
      <Feature Id="DesktopShortcutFeature"
               Title="Desktop shortcut"
               Description="Create an Airplay shortcut on the desktop"
               Level="1"
               AllowAbsent="yes"
               InstallDefault="local">
        <ComponentRef Id="DesktopShortcutComponent"/>
      </Feature>
      <Feature Id="StartMenuShortcutFeature"
               Title="Start menu shortcut"
               Description="Create an Airplay shortcut in the Start menu"
               Level="1"
               AllowAbsent="yes"
               InstallDefault="local">
        <ComponentRef Id="StartMenuShortcutComponent"/>
      </Feature>
    </Feature>
  </Package>
</Wix>
