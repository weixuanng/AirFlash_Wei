<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:AirFlash.App.Ui" x:Class="AirFlash.App.Ui.ControlPanel" Title="Airplay" Width="{x:Static loc:ControlPanel.CompactWidth}" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="OnKeyDown" Deactivated="OnDeactivated" Closing="OnClosing">
  <Window.Resources>
    <!-- Application-owned vectors keep these icons independent of installed fonts. -->
    <Geometry x:Key="ReceiverIconGeometry">M 8,2 H 16 A 3,3 0 0 1 19,5 V 19 A 3,3 0 0 1 16,22 H 8 A 3,3 0 0 1 5,19 V 5 A 3,3 0 0 1 8,2 Z M 15,8 A 3,3 0 1 1 9,8 A 3,3 0 1 1 15,8 Z M 14,16 A 2,2 0 1 1 10,16 A 2,2 0 1 1 14,16 Z</Geometry>
    <Geometry x:Key="PlayIconGeometry">M 6,3 L 21,12 6,21 Z</Geometry>
    <Geometry x:Key="StopIconGeometry">M 4,4 H 20 V 20 H 4 Z</Geometry>
    <!-- The panel's one main control: Connect to the last used speaker, or Disconnect. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- The template draws its own focus ring. -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Chrome" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
              <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="20"/>
              <Border x:Name="Ring" BorderBrush="{DynamicResource TextBrush}" BorderThickness="2" CornerRadius="22" Margin="-3" Visibility="Collapsed"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fill" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="Card" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Background="{DynamicResource CanvasBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="2,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Source="{StaticResource AppLogo}" Width="22" Height="22" VerticalAlignment="Center" Margin="0,1,8,0"/>
          <TextBlock Text="Airplay" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="{loc:Text 'Quit'}" AutomationProperties.Name="{loc:Text 'Quit'}" Click="OnQuit" Margin="0,0,0,0"><Viewbox Width="18" Height="18"><Path Data="M 10,3 L 3,3 3,21 10,21 M 8,12 L 22,12 M 17,7 L 22,12 17,17" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Button>
      </Grid>
      <StackPanel Grid.Row="1">
      <Border Padding="12,10" CornerRadius="10" Background="{DynamicResource TintBrush}" Margin="0,0,0,12" Visibility="{Binding Notice, Converter={StaticResource NonEmpty}}">
        <TextBlock Text="{Binding Notice}" Style="{StaticResource Hint}"/>
      </Border>
      <Border Padding="12,10" CornerRadius="10" Background="{DynamicResource TintBrush}" Margin="0,0,0,12" Visibility="{Binding EngineMessage, Converter={StaticResource NonEmpty}}">
        <StackPanel>
          <TextBlock Text="{Binding EngineMessage}" Style="{StaticResource Hint}"/>
          <Button Content="{loc:Text 'Retry audio engine'}" Command="{Binding RetryEngineCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding EngineFailed, Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
      </Border>
      </StackPanel>
      <ScrollViewer x:Name="DeviceScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
        <StackPanel>
          <Border x:Name="EmptyState" Padding="18,28">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Receivers.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="{Binding DiscoveryEmptyTitle}" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock Text="{loc:Text 'Connect your PC and HomePod to the same network.'}" TextAlignment="Center" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Receivers}" loc:Motion.Stagger="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="10" Margin="0,0,0,8" CornerRadius="12" BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Active}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                          <Setter Property="Background" Value="{DynamicResource TintBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="42"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource AccentBrush}" Width="32" Height="32" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Viewbox Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                          <Path x:Name="ReceiverIcon" Data="{StaticResource ReceiverIconGeometry}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                      </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                      <TextBlock Text="{Binding StateText, NotifyOnTargetUpdated=True}" Style="{StaticResource Hint}" Margin="0,2,0,0" loc:Motion.FadeOnUpdate="True"/>
                    </StackPanel>
                    <!-- Now-playing level bars; they only animate while shown and streaming. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" IsHitTestVisible="False" loc:Motion.Playing="True" Visibility="{Binding IsStreaming, Converter={StaticResource BoolVisibility}}">
                      <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                      <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                      <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                      <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="3" Margin="2,4,2,0">
        <!-- The speaker's own volume; shown only while it reports one. -->
        <Grid x:Name="VolumeRow" Margin="4,0,4,10" Visibility="{Binding VolumeAvailable, Converter={StaticResource BoolVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
          </Grid.ColumnDefinitions>
          <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
            <Path Data="M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z M15,9 C16.5,10.5 16.5,13.5 15,15 M17.5,6.5 C20.5,9.5 20.5,14.5 17.5,17.5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="24" Height="24"/>
          </Viewbox>
          <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" VerticalAlignment="Center"
                  PreviewMouseLeftButtonDown="VolumeSlider_Down" PreviewMouseMove="VolumeSlider_Move" PreviewMouseLeftButtonUp="VolumeSlider_Up" PreviewMouseWheel="VolumeSlider_Wheel" SizeChanged="VolumeSlider_SizeChanged" ValueChanged="VolumeSlider_ValueChanged" Loaded="VolumeSlider_Loaded"
                  Value="{Binding DeviceVolume, Mode=TwoWay}" ToolTip="{loc:Text 'Speaker volume'}" AutomationProperties.Name="{loc:Text 'Speaker volume'}"/>
          <TextBlock Grid.Column="2" Text="{Binding DeviceVolumeText}" Style="{StaticResource Hint}" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrimaryCommand}" ToolTip="{Binding PrimaryLabel}" AutomationProperties.Name="{Binding PrimaryLabel}" HorizontalAlignment="Stretch" Margin="0,2,0,10">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0">
              <Grid Width="24" Height="24">
                <Path x:Name="PrimaryIcon" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Setter Property="Data" Value="{StaticResource PlayIconGeometry}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PrimaryIsStop}" Value="True">
                          <Setter Property="Data" Value="{StaticResource StopIconGeometry}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Grid>
            </Viewbox>
            <TextBlock Text="{Binding PrimaryLabel}" VerticalAlignment="Center" MaxWidth="230" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
          </StackPanel>
        </Button>
        <!-- Two choices that trade something for robustness; both are off by default. -->
        <StackPanel x:Name="OptionsRow" Margin="6,0,6,8">
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Text 'Delay'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="DelayOption" Grid.Column="1" SelectedIndex="{Binding DelayMode, Mode=TwoWay}" ToolTip="{loc:Text 'Lowest keeps sound closest to video and steps the delay up only if the stream has trouble. Most stable gives lost packets time to be sent again.'}" AutomationProperties.Name="{loc:Text 'Delay'}">
              <ComboBoxItem Content="{loc:Text 'Lowest (adapts)'}"/>
              <ComboBoxItem Content="{loc:Text 'Balanced'}"/>
              <ComboBoxItem Content="{loc:Text 'Most stable'}"/>
            </ComboBox>
          </Grid>
          <CheckBox x:Name="DirectCaptureOption" IsChecked="{Binding DirectCapture, Mode=TwoWay}" IsEnabled="{Binding DirectCaptureAvailable}" Content="{loc:Text 'Capture apps directly'}" ToolTip="{loc:Text 'Takes audio from apps before the PC speakers, so the PC can stay muted. Turn off if the speaker goes silent.'}"/>
        </StackPanel>
        <DockPanel>
          <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" loc:Motion.Breathe="{Binding StatusBusy}">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource MutedBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusTone}" Value="live"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding StatusTone}" Value="busy"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding StatusTone}" Value="wait"><Setter Property="Fill" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding StatusTone}" Value="error"><Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding StatusTitle, NotifyOnTargetUpdated=True}" FontWeight="SemiBold" FontSize="12" loc:Motion.FadeOnUpdate="True"/>
        </DockPanel>
        <TextBlock x:Name="StatusDetailText" Text="{Binding StatusDetail}" Style="{StaticResource Hint}" Margin="15,4,0,0" MaxHeight="84" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}" Visibility="{Binding StatusDetail, Converter={StaticResource NonEmpty}}"/>
        <TextBlock x:Name="PairingActionHint" Text="{Binding ActionHint, NotifyOnTargetUpdated=True}" Style="{StaticResource Hint}" Margin="15,2,0,0" TextWrapping="Wrap" Visibility="{Binding ActionHint, Converter={StaticResource NonEmpty}}" AutomationProperties.Name="{Binding ActionHint}" AutomationProperties.LiveSetting="Polite" TargetUpdated="OnActionHintUpdated"/>
        <Button Content="{loc:Text 'Reconnect'}" Command="{Binding ReconnectCommand}" Visibility="{Binding CanReconnect, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="15,8,0,0" Padding="12,4" AutomationProperties.Name="{loc:Text 'Reconnect'}"/>
        <Expander Header="{loc:Text 'View error details'}" Visibility="{Binding ErrorDetails, Converter={StaticResource NonEmpty}}" Margin="0,8,0,0">
          <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding ErrorDetails}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
          </ScrollViewer>
        </Expander>
      </StackPanel>
      <!-- Errors spring open here, over the header, like the Dynamic Island. It sits
           against the Quit button's left edge and grows leftwards, so Quit stays clickable. -->
      <loc:ErrorIsland Grid.RowSpan="4" Panel.ZIndex="10" Margin="0,-8,40,0" IsOpen="{Binding IslandActive}" Title="{Binding IslandTitle}" Message="{Binding IslandMessage}"/>
    </Grid>
  </Border>
</Window>
