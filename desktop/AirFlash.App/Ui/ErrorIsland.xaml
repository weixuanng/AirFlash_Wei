<?xml version="1.0" encoding="utf-8"?>
<!-- The panel's Dynamic Island: a black capsule over the header that shows what the
     connection is doing. Playing, connecting, waiting for another device and standby sit
     as a compact pill; an error springs open with its message and settles back. A click
     opens or closes it. Its size morphs on the same spring as the web page's island. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:AirFlash.App.Ui" x:Class="AirFlash.App.Ui.ErrorIsland" x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Focusable="True" Cursor="Hand" AutomationProperties.LiveSetting="Assertive" FocusVisualStyle="{x:Null}">
  <UserControl.Resources>
    <Geometry x:Key="AlertGlyph">M 7.1,3.4 H 8.9 V 9.6 H 7.1 Z M 6.95,11.9 A 1.05,1.05 0 1 1 9.05,11.9 A 1.05,1.05 0 1 1 6.95,11.9 Z</Geometry>
    <!-- One mark per state, chosen by Tag: error and wait (a disc), busy (a turning arc),
         live (level bars) and standby (a moon). -->
    <Style x:Key="ToneIcon" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <Grid x:Name="Alert">
                <Ellipse x:Name="Disc" Fill="#FF453A"/>
                <Path Data="{StaticResource AlertGlyph}" Fill="White"/>
              </Grid>
              <Path x:Name="Arc" Visibility="Collapsed" Data="M 8,1.6 A 6.4,6.4 0 1 1 1.6,8" Stroke="#0A84FF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" loc:Motion.Spin="True"/>
              <StackPanel x:Name="Bars" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="12" loc:Motion.Playing="True">
                <Rectangle Width="2.6" Height="12" RadiusX="1.3" RadiusY="1.3" Fill="#30D158" VerticalAlignment="Bottom" Margin="0,0,1.8,0"/>
                <Rectangle Width="2.6" Height="12" RadiusX="1.3" RadiusY="1.3" Fill="#30D158" VerticalAlignment="Bottom" Margin="0,0,1.8,0"/>
                <Rectangle Width="2.6" Height="12" RadiusX="1.3" RadiusY="1.3" Fill="#30D158" VerticalAlignment="Bottom" Margin="0,0,1.8,0"/>
                <Rectangle Width="2.6" Height="12" RadiusX="1.3" RadiusY="1.3" Fill="#30D158" VerticalAlignment="Bottom"/>
              </StackPanel>
              <Path x:Name="Moon" Visibility="Collapsed" Fill="#8E8CFF" Data="M 13.4,9.9 A 6,6 0 1 1 6.1,2.6 A 4.7,4.7 0 0 0 13.4,9.9 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="wait"><Setter TargetName="Disc" Property="Fill" Value="#FF9F0A"/></Trigger>
              <Trigger Property="Tag" Value="busy"><Setter TargetName="Alert" Property="Visibility" Value="Collapsed"/><Setter TargetName="Arc" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="Tag" Value="live"><Setter TargetName="Alert" Property="Visibility" Value="Collapsed"/><Setter TargetName="Bars" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="Tag" Value="standby"><Setter TargetName="Alert" Property="Visibility" Value="Collapsed"/><Setter TargetName="Moon" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border x:Name="Pill" Background="Black" CornerRadius="17" Width="92" Height="32" ClipToBounds="True" RenderTransformOrigin="0.5,0" SnapsToDevicePixels="True" MouseLeftButtonUp="OnClick">
    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
    <Grid>
      <StackPanel x:Name="Compact" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,12,0">
        <ContentControl Style="{StaticResource ToneIcon}" Tag="{Binding Tone, ElementName=Root}" VerticalAlignment="Center"/>
        <TextBlock x:Name="CompactText" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="66"/>
      </StackPanel>
      <Grid x:Name="Expanded" Margin="12,0,12,0" Opacity="0" VerticalAlignment="Center" IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Viewbox Width="22" Height="22" VerticalAlignment="Center">
          <ContentControl Style="{StaticResource ToneIcon}" Tag="{Binding Tone, ElementName=Root}"/>
        </Viewbox>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="MessageText" Foreground="#C7C7CC" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="46"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
