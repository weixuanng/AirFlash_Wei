<?xml version="1.0" encoding="utf-8"?>
<!-- Error pop-up in the style of the iPhone Dynamic Island: a black capsule that
     springs open with the error, settles to a compact pill, and expands again on click. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AirFlash.App.Ui.ErrorIsland" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Focusable="True" Cursor="Hand" AutomationProperties.LiveSetting="Assertive" FocusVisualStyle="{x:Null}">
  <UserControl.Resources>
    <Geometry x:Key="AlertGlyph">M 7.1,3.4 H 8.9 V 9.6 H 7.1 Z M 6.95,11.9 A 1.05,1.05 0 1 1 9.05,11.9 A 1.05,1.05 0 1 1 6.95,11.9 Z</Geometry>
  </UserControl.Resources>
  <Border x:Name="Pill" Background="Black" CornerRadius="17" Width="132" Height="34" ClipToBounds="True" RenderTransformOrigin="0.5,0" SnapsToDevicePixels="True" MouseLeftButtonUp="OnClick">
    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
    <Grid>
      <StackPanel x:Name="Compact" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
        <Grid Width="16" Height="16" VerticalAlignment="Center">
          <Ellipse Fill="#FF453A"/>
          <Path Data="{StaticResource AlertGlyph}" Fill="White"/>
        </Grid>
        <TextBlock x:Name="CompactText" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90"/>
      </StackPanel>
      <Grid x:Name="Expanded" Margin="14,0,16,0" Opacity="0" VerticalAlignment="Center" IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Viewbox Width="28" Height="28" VerticalAlignment="Center">
          <Grid Width="16" Height="16">
            <Ellipse Fill="#FF453A"/>
            <Path Data="{StaticResource AlertGlyph}" Fill="White"/>
          </Grid>
        </Viewbox>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="MessageText" Foreground="#C7C7CC" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
